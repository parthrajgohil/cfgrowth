{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "Write(accounts/**)",
      "Edit(accounts/**)",
      "Write(drafts/**)",
      "Edit(drafts/**)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls *)"
    ],
    "ask": [
      "Write(pipeline/**)",
      "Edit(pipeline/**)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(osascript *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Read(.env*)",
      "Read(**/*.pem)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*|Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/approval-gate.sh"
          }
        ]
      }
    ]
  }
}
