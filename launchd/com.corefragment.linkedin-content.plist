<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.corefragment.linkedin-content</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/cfgrowth/cf-growth/scripts/linkedin-content.sh</string>
  </array>
  <!-- Tue, Wed, Thu at 11:47 IST: post arrives in Teams before the EU lunchtime window. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>47</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>47</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>47</integer></dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/cfgrowth/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/cfgrowth/cf-growth/logs/launchd-linkedin.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/cfgrowth/cf-growth/logs/launchd-linkedin.err.log</string>
</dict>
</plist>
