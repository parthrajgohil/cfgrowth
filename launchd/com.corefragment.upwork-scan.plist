<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.corefragment.upwork-scan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/cfgrowth/cf-growth/scripts/upwork-scan.sh</string>
  </array>
  <!-- Every day (incl. weekends, CEO 2026-10-10: urgent hires post on weekends) at 10:33,
       13:33, 17:33, 20:33, 23:33 IST: US overnight posts, EU morning, EU afternoon / US East
       early, US East morning, US midday / US West morning. :33 keeps clear of the hourly
       lead run at :03. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>33</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>33</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>33</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>33</integer></dict>
    <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>33</integer></dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/cfgrowth/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/cfgrowth/cf-growth/logs/launchd-upwork.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/cfgrowth/cf-growth/logs/launchd-upwork.err.log</string>
</dict>
</plist>
